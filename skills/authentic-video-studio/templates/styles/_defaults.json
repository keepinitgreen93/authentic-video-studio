{
  "description": "",
  "format": {"width": 1080, "height": 1920, "fps": 30, "crf": 18, "preset": "medium", "audio_bitrate": "192k"},
  "cleanup": {"max_gap_keep_s": 0.30, "pad_lead_s": 0.06, "pad_tail_s": 0.10, "first_word_lead_s": 0.05,
              "end_tail_s": 0.35, "crossfade_ms": 6, "remove_immediate_repeats": true,
              "remove_fillers": ["um", "uh", "uhm", "er", "erm", "ah", "hmm", "mm"]},
  "cuts": {"enabled": true, "hook_shot_min_s": 3.5, "shot_min_s": 4.5, "shot_target_s": 7.0, "shot_max_s": 11.0},
  "zoom": {"mode": "none", "base": 1.0, "max": 1.0, "ramp_s": 3.3, "open_from": 1.0, "open_s": 0.85},
  "layout": {"mode": "full",
             "window": {"x": 70, "y": 360, "w": 940, "h": 1150},
             "background": {"color": "{brand.colors.background}", "grid_color": "{brand.colors.primary}",
                            "grid_size": 120, "grid_opacity": 0.16}},
  "captions": {"mode": "word", "words_per_chunk": 1, "max_words": 5, "max_hold_s": 0.9, "case": "as_spoken",
               "font_role": "heading", "size_px": 100, "fill": "#FFFFFF", "stroke_color": "#020617", "stroke_px": 7,
               "shadow_px": 2, "y_frac": 0.78, "x_frac": 0.5, "max_width_frac": 0.84,
               "pop": {"enabled": true, "from_scale_pct": 88, "ms": 90},
               "emphasis": {"numerals": true, "extra_words": [], "color": "{brand.colors.accent}"},
               "highlight_color": "{brand.colors.accent}",
               "strip": {"enabled": false, "color": "#0B0F19", "opacity": 0.8, "padding_px": 20},
               "strip_chars": "-"},
  "hook_text": {"max_s": 3.2, "y_frac": 0.15, "font_size_px": 84, "max_lines": 2, "max_chars_per_line": 16,
                "fill": "#FFFFFF", "box_color": "{brand.colors.primary}", "box_opacity": 0.92},
  "end_card": {"text_template": "{TEXT}", "last_s": 2.4, "y_frac": 0.15, "font_size_px": 84, "fill": "#FFFFFF",
               "box_color": "{brand.colors.accent}", "box_opacity": 0.95},
  "logo": {"enabled": true, "margin_px": 48, "top_px": 120, "opacity": 0.95},
  "audio": {"target_lufs": -14.0, "true_peak_db": -1.5, "lra": 11, "highpass_hz": 70, "sample_rate": 48000},
  "srt": false
}
